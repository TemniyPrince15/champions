# Free AI through OpenRouter. Create a key in the OpenRouter dashboard.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional. Defaults to the free router.
OPENROUTER_MODEL=openrouter/free
# Optional URL used for OpenRouter attribution.
NEXT_PUBLIC_APP_URL=http://localhost:3000

